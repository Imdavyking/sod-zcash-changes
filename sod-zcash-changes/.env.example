# --- Testnet server (src/server.ts, `npm run start`) ---
SOD_NETWORK=testnet                      # testnet | regtest. mainnet is refused: single-key escrow is custodial.
ZEBRA_RPC_URL=http://127.0.0.1:18232     # Zebra (testnet) JSON-RPC, used for the chain tip
# ZEBRA_RPC_USER=
# ZEBRA_RPC_PASSWORD=
ZALLET_RPC_URL=http://127.0.0.1:28232    # Zallet (or zcashd-compatible) wallet JSON-RPC, holds the escrow key
ZALLET_RPC_USER=
ZALLET_RPC_PASSWORD=
ESCROW_ACCOUNT=0                         # wallet account that receives donations
# SOD_PRIVACY_POLICY=AllowRevealedAmounts  # z_sendmany policy; needed if a refund goes to a Sapling (zs1) address

# --- Both servers ---
PORT=8787
SOD_REVEAL_TOTALS=after-deadline         # live | after-deadline
SOD_DATA_DIR=./data
